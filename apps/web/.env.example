NEXT_PUBLIC_NODE_ENV=production

# Switch the complete local endpoint set with: devnet, testnet, or mainnet.
NEXT_PUBLIC_NETWORK_PROFILE=testnet

# Optional per-value overrides. Leave unset to use the selected profile.
# NEXT_PUBLIC_CHAIN_NAME=lumera-testnet
# NEXT_PUBLIC_DENOM=ulume
# NEXT_PUBLIC_CHAIN_ID=lumera-testnet-2
# NEXT_PUBLIC_REST_AI_URL=https://lcd-testnet.lumeraprotocol.com
# NEXT_PUBLIC_RPC_ENDPOINT=https://rpc-testnet.lumeraprotocol.com
# NEXT_PUBLIC_EVM_PROFILE_NAME=lumera-testnet-evm
# NEXT_PUBLIC_EVM_RPC_ENDPOINT=https://evm-testnet.lumeraprotocol.com
# NEXT_PUBLIC_EVM_WS_ENDPOINT=https://evm-ws-testnet.lumeraprotocol.com
# NEXT_PUBLIC_EVM_CHAIN_ID=76857769
# Enable only after the chain and hub MetaMask Cosmos signer are both ready.
# NEXT_PUBLIC_COSMOS_EIP712_ENABLED=false
# NEXT_PUBLIC_SNAPI_URL=http://localhost:3100
# NEXT_PUBLIC_SDK_PRESET=testnet
# NEXT_PUBLIC_SNSCOPE_URL=https://snscope.testnet.lumera.io/
# Canonical origin for this deployment. Defaults per profile:
#   mainnet -> https://hub.lumera.io       testnet -> https://hub.testnet.lumera.io
# NEXT_PUBLIC_SITE_URL=https://hub.testnet.lumera.io
# The faucet, on non-mainnet builds only — there is no free mainnet LUME.
# Set NEXT_PUBLIC_FAUCET_URL to send people to a faucet hosted elsewhere; it
# replaces the in-app screen with a sidebar link.
# NEXT_PUBLIC_FAUCET_URL=
# Otherwise the hub's own /faucet screen is used. Its two halves are configured
# separately because they fail separately:
#   FAUCET_API is a service holding a funded account. The hub POSTs
#   {"address": "lumera1…"} to it and expects it to sign and broadcast. Without
#   it the screen explains itself rather than offering a button that cannot work.
#   FAUCET_ADDRESS is that account's address, read-only. A faucet's sends are
#   ordinary transactions, so the drip log comes off the chain and works on its
#   own — real history shows even before the sending half exists.
# NEXT_PUBLIC_FAUCET_API=
# NEXT_PUBLIC_FAUCET_ADDRESS=
# The other network's hub, for the sidebar switch. Unset, no switch is offered.
# NEXT_PUBLIC_SIBLING_HUB_URL=
# The dashboard's post card, in order of preference.
# With a bearer it reads the X API, which needs an app attached to a Project
# and a tier that can read timelines. Paste the token exactly as the portal
# shows it; the percent-encoding is handled. Reads are billed per post, so the
# bill is LIMIT posts every REVALIDATE_S in the route — three every half hour
# is roughly $20 a month, and widening the interval is the cheapest lever.
# X_BEARER_TOKEN=
# Or the app's key and secret, from which a bearer is minted.
# X_API_KEY=
# X_API_KEY_SECRET=
# Without either it falls back to the endpoint X's own embed widget calls,
# which needs no key but throttles hard per address.
# NEXT_PUBLIC_X_HANDLE=lumera
# Local development only, ignored in production. That endpoint allows roughly
# one request per half hour per address and blocks for several minutes once
# tripped, so iterating on the card against the live feed stops it quickly.
# Point this at a saved response to work on the card offline:
#   curl -A 'Mozilla/5.0' \
#     https://syndication.twitter.com/srv/timeline-profile/screen-name/lumera \
#     > .local-fixtures/x-timeline.html
# X_FEED_FIXTURE=/abs/path/to/x-timeline.html

NEXT_PUBLIC_SNAPI_URL=http://localhost:3100
NEXT_PUBLIC_SDK_PRESET=
NEXT_PUBLIC_SNSCOPE_URL=
NEXT_PUBLIC_UPLOAD_MAX_FILES=10
NEXT_PUBLIC_MAX_REQUESTS=14
NEXT_PUBLIC_GOOGLE_ANALYSICS_KEY=
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_KEY=
NEXT_PUBLIC_MAX_TRACKING_REQUESTS=20
NEXT_PUBLIC_ADMIN_EMAIL=
NEXT_PUBLIC_ADMIN_PASSWORD=
JWT_SECRET=
JWT_EXPIRY=1d
# The quest service. Every SNAG route answers 500 without these, and the API
# client refuses to call them at all unless NEXT_PUBLIC_SNAG_ENABLED is "true"
# — they fire from ordinary flows, so an unconfigured deployment would show
# errors over work that succeeded.
# NEXT_PUBLIC_SNAG_ENABLED=false
SNAG_API_KEY=
SNAG_ORGANIZATION_ID=
SNAG_WEBSITE_ID=
SNAG_BASE_URL=
NEXT_PUBLIC_GOOGLE_RECAPTCHA_CLIENT_SITE_KEY=
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_IPAPI_KEY=
NEXT_PUBLIC_ABSTRACTAPI_KEY=

# OpenRouter API key for the chat test page (server-side only).
OPENROUTER_API_KEY=
